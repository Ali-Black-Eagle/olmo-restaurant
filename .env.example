# Copy to .env (Next.js and Prisma both read it). Never commit real values.

# PostgreSQL. Locally: run `npm run db:local` (no Docker) and use the URL below.
# On Vercel: add Neon from the Marketplace and it fills this in for you (use the pooled URL).
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/olmo"

# Resend (https://resend.com). Leave empty in development: emails are printed to the server log instead.
RESEND_API_KEY=""
# Needs a verified domain in production. In development Resend's test sender only delivers to your own account email.
EMAIL_FROM="Olmo <bookings@your-domain.example>"
# Receives a copy of every new booking and cancellation. Optional.
STAFF_NOTIFY_EMAIL="staff@your-domain.example"

# Better Auth (admin magic links). Generate the secret with: npx @better-auth/cli secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated staff emails. Only these addresses can sign in to /admin.
ADMIN_EMAILS="you@your-domain.example"

# Vercel Blob read/write token, for dish photo uploads in the admin. Optional (you can paste image links instead).
BLOB_READ_WRITE_TOKEN=""

# Public URL of the site, used in emails, sitemap, canonical URLs and structured data.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
